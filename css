body {
  font-family: Arial, sans-serif;
  background-color: #fff5f7;
  color: #333;
  margin: 0;
  padding: 0;
}

header.hero {
  background-color: #ff6b8b;
  color: white;
  text-align: center;
  padding: 40px 20px;
}

.tag-festa {
  background: rgba(255, 255, 255, 0.3);
  padding: 5px 12px;
  border-radius: 20px;
  font-size: 14px;
}

h1 {
  margin: 15px 0 10px 0;
  font-size: 32px;
}

.container {
  max-width: 800px;
  margin: 30px auto;
  padding: 0 20px;
}

.card-grid {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}